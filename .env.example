# Copy to .env and replace every CHANGE_ME value before starting the full stack.
POSTGRES_DB=rag_app
POSTGRES_USER=rag_app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
LITELLM_MASTER_KEY=CHANGE_ME_LITELLM_MASTER_KEY
LITELLM_SALT_KEY=CHANGE_ME_LITELLM_SALT_KEY
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
RAGAS_EVALUATOR_MODEL=evaluation-judge
# Phase 1 accepts Langfuse configuration; tracing starts with the workflow phase.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
